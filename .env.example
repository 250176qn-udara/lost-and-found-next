# Copy this file to .env.local and change the values if needed.
# Laragon / XAMPP defaults: user "root", empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lost_and_found
DB_USER=root
DB_PASSWORD=

# At least 32 random characters. Used to encrypt the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# Google Maps (Maps JavaScript API). Create a key in Google Cloud Console → APIs & Services → Credentials,
# enable "Maps JavaScript API", and restrict the key to your site (HTTP referrers). Restart the app after changing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud → Map Management). Leave empty to use Google's DEMO_MAP_ID while testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# PAY.JP (card payments for thank-you gifts). Dashboard → API: use the TEST keys (pk_test_… / sk_test_…).
# Keep the secret key out of Git. With test keys no real money moves and gift codes are marked TEST.
NEXT_PUBLIC_PAYJP_PUBLIC_KEY=
PAYJP_SECRET_KEY=
