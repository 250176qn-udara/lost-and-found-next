# Copy this file to .env.local and change the values if needed.
# Laragon / XAMPP defaults: user "root", empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lost_and_found
DB_USER=root
DB_PASSWORD=

# At least 32 random characters. Used to encrypt the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# Maps: OpenStreetMap + the campus floor plan. Free, no key needed.

# Gemini AI (optional, free): "Fill in from a photo" and smarter matching. Get a key at https://aistudio.google.com/apikey
# Without a key the app uses the rule-based matching. On the free tier Google may use the data to improve its products.
GEMINI_API_KEY=
# Optional: pin a model. Default: gemini-flash-latest (Google's current free Flash model).
GEMINI_MODEL=

# PAY.JP (card payments for thank-you gifts). Dashboard → API: use the TEST keys (pk_test_… / sk_test_…).
# Keep the secret key out of Git. With test keys no real money moves and gift codes are marked TEST.
NEXT_PUBLIC_PAYJP_PUBLIC_KEY=
PAYJP_SECRET_KEY=

# Email (optional). Without SMTP_HOST, mails are saved as .eml files in ./mail-outbox instead of being sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=an "app password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lost & Found <no-reply@example.com>
# Base URL used for links inside emails.
APP_URL=http://localhost:3000
